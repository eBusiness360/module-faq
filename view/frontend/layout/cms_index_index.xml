<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- La page d'accueil est une page CMS servie par une autre action que cms_page_view. -->
        <referenceContainer name="content">
            <block class="Maxcode\Faq\Block\Faq" name="maxcode.faq.cms" after="-">
                <arguments>
                    <argument name="mode" xsi:type="string">entity</argument>
                    <argument name="entity_type" xsi:type="string">cms_page</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
